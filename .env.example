# Required: the passcode you type to open the dashboard
APP_PASSCODE=choose-something-long

# Required for AI coaching (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Required in production: Supabase project (Settings -> API). Without these the app
# stores data in .data/db.json, which only works locally.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: push notification keys. If unset, the app generates a pair on
# first use and stores it in the database.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shared secret the GitHub Actions reminder job sends to /api/cron
CRON_SECRET=

# Optional morning email via Resend (https://resend.com)
RESEND_API_KEY=
REMINDER_EMAIL_TO=
REMINDER_EMAIL_FROM=Human 3.0 <onboarding@resend.dev>

# Public URL of the deployed app (used in emails and notifications)
APP_URL=http://localhost:3000
